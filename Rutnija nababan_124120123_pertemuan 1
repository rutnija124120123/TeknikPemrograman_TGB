username = "admin"
password = "12345"

percobaan = 0
while percobaan < 3:
    user = input("Username: ")
    pw = input("Password: ")

    if user == username and pw == password:
        print("Login berhasil!")
        break
    else:
        print("Username atau password salah.")
        percobaan += 1

if percobaan == 3:
    print("Akun terkunci karena 3x gagal login.")
